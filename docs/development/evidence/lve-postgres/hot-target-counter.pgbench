-- Rejected alternative CHOICE-05 B for comparison only: the same transaction plus a
-- transactional counter row per target (bench_counters exists only in the scratch database).
\set n random(1, 5000)
BEGIN;
SELECT 1 FROM publications WHERE work_id = :work FOR SHARE;
SELECT 1 FROM discussion_threads WHERE id = :thread FOR SHARE;
SELECT 1 FROM comments WHERE id = :hot AND thread_id = :thread FOR SHARE;
SELECT selected, version FROM comment_endorsements
 WHERE comment_id = :hot AND actor_id = ('00000000-0000-4000-8000-' || lpad(cast(:n as text), 12, '0'))::uuid
   FOR UPDATE;
UPDATE comment_endorsements SET selected = NOT selected, version = version + 1, updated_at = now()
 WHERE comment_id = :hot AND actor_id = ('00000000-0000-4000-8000-' || lpad(cast(:n as text), 12, '0'))::uuid;
UPDATE bench_counters SET selected = selected + 1 WHERE comment_id = :hot;
SELECT selected FROM bench_counters WHERE comment_id = :hot;
END;
