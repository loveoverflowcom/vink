      "decision": "KEEP_BASELINE",
      "rationale": "Cold hydration=0 /works or /reader requests; warm Back=0 /works requests; 121s burst=1 wire 304."
    },
    {
      "id": "WEB-PERF-02",
      "target": "#235 Selective SSR Streaming vs Async",
      "decision": "HOLD_ASYNC_UNTIL_BOTTLENECK",
      "rationale": "Measured cold Explore median LCP=72 ms on release loopback; only spike selective streaming under controlled 200ms/1000ms secondary latency."
    },
    {
      "id": "WEB-PERF-03",
      "target": "#236 Navigation anchor / Keep-Alive",
      "decision": "EVALUATE_ANCHOR_SPIKE",
      "rationale": "Warm Back median=125.986 ms with 0 network requests; qualify anchor tolerance across 50 cycles before considering kept-alive DOM."
    },
    {
      "id": "WEB-PERF-04",
      "target": "#238 Secondary content-visibility containment",
      "decision": "NO_CONTAINMENT_NEEDED_YET",
      "rationale": "Cold 200k Reader median hydrated=255.15 ms; keep full article DOM and test secondary-only containment against find/selection/print."
    },
    {
      "id": "WEB-PERF-07",
      "target": "#237 RAM retention hard byte budget",
      "decision": "MEASURE_BYTE_PRESSURE_NEXT",
      "rationale": "25-cycle disposal bounded=true; soft cap 16 entries currently lacks hard byte cap for multi-200k snapshots."
    },
    {
      "id": "WEB-PERF-06",
      "target": "#239 Public intent-prefetch",
      "decision": "NO_GO_BEFORE_BUDGET_AND_SSR_DECISION",
      "rationale": "Prefetch adds wasted bytes/late-response risk; keep disabled until #235 and #237 establish remaining wait."
