VINK_PROD_PLATFORM=linux/amd64
VINK_PROD_UID=10001
VINK_POSTGRES_VOLUME=vink-prod-postgres
VINK_PROD_DB_NETWORK=vink-prod-db
VINK_PROD_EDGE_NETWORK=vink-prod-ingress
VINK_PROD_SECRETS_DIR=/etc/vink-prod/runtime
VINK_PROD_SOCKET_DIR=/run/vink-prod-identity
VINK_PROD_POSTGRES_IMAGE=docker.io/library/postgres@sha256:e5d2edd28b1f8d40a0a6c0c9cdc545b19b56a0d5d88f94bc11a97d970d4700d0
VINK_PROD_APP_IMAGE=
VINK_PROD_WORKER_IMAGE=
VINK_PROD_IDENTITY_IMAGE=
VINK_PROD_NOTIFICATIONS_IMAGE=
VINK_PROD_INBOX_DIR=/run/vink-prod-inbox
VINK_PROD_INGEST_DIR=/run/vink-prod-ingest
# #536: the worker runs the scripted mock approve by default (not an AI review). To opt out, set one
# of these and recreate the worker: manual sends every job to people; disabled stops the consumer.
# VINK_PROD_EVALUATOR=manual
# VINK_PROD_WORKER_EVALUATION=disabled
