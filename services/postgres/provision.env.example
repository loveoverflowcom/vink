# Settings for provision.sh, in shell syntax (`provision.sh --env-file FILE`). Copy to
# services/postgres/provision.env (git-ignored) and adjust. The values here are the throwaway
# credentials of the local container only, matching .env.example; never reuse them elsewhere.
# Production keeps these in its own secret store and may pass SCRAM verifiers as passwords.

# Bootstrap/operator superuser (libpq); PGDATABASE is a maintenance database.
PGHOST=127.0.0.1
PGPORT=55432
PGUSER=vink
PGPASSWORD=vink-local-only
PGDATABASE=postgres

# Owner names (these are the defaults).
VINK_APP_DATABASE=vink
VINK_APP_MIGRATOR_ROLE=vink_app_migrator
VINK_APP_RUNTIME_ROLE=vink_app_runtime
VINK_IDENTITY_DATABASE=vink_identity
VINK_IDENTITY_MIGRATOR_ROLE=vink_identity_migrator
VINK_IDENTITY_RUNTIME_ROLE=vink_identity_runtime

# Used only to create a missing role; an existing role keeps its password.
VINK_APP_MIGRATOR_PASSWORD=vink-app-migrator-local-only
VINK_APP_RUNTIME_PASSWORD=vink-app-runtime-local-only
VINK_IDENTITY_MIGRATOR_PASSWORD=vink-identity-migrator-local-only
VINK_IDENTITY_RUNTIME_PASSWORD=vink-identity-runtime-local-only
