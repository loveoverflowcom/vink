# Copy to `.env` for local development. `cargo xtask` loads `.env` for the commands it runs;
# the binaries themselves read only real environment variables. No production secret belongs here.
# Credentials below are throwaway values of the local container (services/postgres) after
# `services/postgres/provision.sh --env-file services/postgres/provision.env.example`.

# Runtime role (serve, worker, dev-seed): DML on the App tables, no DDL, no other database.
DATABASE_URL=postgres://vink_app_runtime:vink-app-runtime-local-only@127.0.0.1:55432/vink

# Migration role (`vink-app migrate`, `cargo xtask db migrate|dev`): owns the App schema objects,
# no superuser. `migrate` reads only this variable and never falls back to DATABASE_URL.
VINK_MIGRATE_DATABASE_URL=postgres://vink_app_migrator:vink-app-migrator-local-only@127.0.0.1:55432/vink

# Test harness only (`cargo xtask verify postgres|web`): the container's bootstrap superuser,
# which creates and drops scratch databases and roles. Never give it to the app.
VINK_TEST_DATABASE_URL=postgres://vink:vink-local-only@127.0.0.1:55432/postgres

# Identity (services/vink-identity): `cargo xtask dev` migrates and starts it when VINK_IDENTITY_SOCKET
# is set, and sets VINK_IDENTITY_CALLER_UID / VINK_IDENTITY_SERVER_UID to your user id when unset.
# By default Identity has no authority (`authority_not_configured`), and the local fixture below
# still decides who uses the desk. Remove these lines to run the App without Identity.
VINK_IDENTITY_SOCKET=target/identity/identity.sock
VINK_IDENTITY_DATABASE_URL=postgres://vink_identity_runtime:vink-identity-runtime-local-only@127.0.0.1:55432/vink_identity
VINK_IDENTITY_MIGRATE_DATABASE_URL=postgres://vink_identity_migrator:vink-identity-migrator-local-only@127.0.0.1:55432/vink_identity
# Optional D-05 native email-code authority. For development the delivery worker writes codes as
# files to the local outbox (create it with `mkdir -m 700`); nothing is mailed.
# VINK_DEV_PRINCIPAL still wins when set.
# VINK_IDENTITY_AUTHORITY=email-code
# VINK_IDENTITY_MAIL_TRANSPORT=local-outbox
# VINK_IDENTITY_LOCAL_OUTBOX=target/identity/outbox
# Real mail goes through SMTP (Resend: smtp.resend.com, `tls` on 465, user `resend`, the API key in
# a 0600 file OUTSIDE the repository). Never put a key in this file or in git; see
# docs/development/auth-operations.md. Plain SMTP (`none`) is accepted only for a loopback relay.
# VINK_IDENTITY_MAIL_TRANSPORT=smtp
# VINK_IDENTITY_SMTP_PROVIDER=resend
# VINK_IDENTITY_SMTP_SECURITY=starttls   # 587; use it where a firewall intercepts TLS on 465
# VINK_IDENTITY_SMTP_PASSWORD_FILE=/absolute/path/outside/the/repo/smtp-password
# VINK_IDENTITY_MAIL_FROM=Vink <no-reply@your-verified-domain>

# `local` enables the development seed and the loopback identity fixture. Default: production.
VINK_PROFILE=local
VINK_BIND=127.0.0.1:3000
VINK_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Sign-in routes may start sessions: default `enabled` in the local profile, `disabled` in
# production (D-05 Provisional; enable only after its gates). Proxies whose X-Forwarded-For names
# the client network for sign-in rate limits; empty = only the TCP peer counts.
# VINK_AUTH_SIGN_IN=enabled
# VINK_TRUSTED_PROXIES=127.0.0.1
VINK_SITE_ROOT=target/site
# vink-worker: the discussion outbox (DISC-04). `disabled` only pauses delivery; nothing is
# deleted and the App keeps writing events. Concurrency 1..=6 (default 4).
# VINK_WORKER_OUTBOX=enabled
# VINK_WORKER_OUTBOX_CONCURRENCY=4

# Loopback-only identity fixture (not authentication). Seeded principals:
#   11111111-1111-4111-8111-111111111111  owner of the [Mẫu] sample work
#   22222222-2222-4222-8222-222222222222  another writer, to see that drafts stay private
VINK_DEV_PRINCIPAL=11111111-1111-4111-8111-111111111111

# text (default) or json
VINK_LOG_FORMAT=text
