      },
      "dark": {
        "x": 0,
        "y": 16,
        "blur": 48,
        "spread": 0,
        "color": {
          "ref": "{black}",
          "alpha": 0.4
        }
      },
      "rationale": "Raised overlays (dialog, account panel). CSS name kept as --vk-shadow.",
      "css": "--vk-shadow"
    },
    "action.primary.container": {
      "type": "color",
      "value": "{color.primary}",
      "rationale": "Recipe: Filled main action."
    },
    "action.primary.content": {
      "type": "color",
      "value": "{color.on-primary}",
      "rationale": "Recipe: Label on the filled main action."
    },
