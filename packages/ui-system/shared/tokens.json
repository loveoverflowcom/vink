    },
    "font.ui": {
      "type": "fontFamily",
      "value": [
        "Be Vietnam Pro",
        "Noto Sans",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ],
      "native": "sansSerif",
      "rationale": "UI text: shipped Be Vietnam Pro 400/600 faces."
    },
    "font.reading": {
      "type": "fontFamily",
      "value": [
        "Literata",
        "Noto Serif",
        "Source Serif 4",
        "Georgia",
        "Times New Roman",
        "serif"
      ],
      "native": "serif",
      "rationale": "Reading, editor and headings: Literata variable."
    },
    "font.code": {
      "type": "fontFamily",
      "value": [
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ],
      "native": "monospace",
      "rationale": "New in UIS-01: system monospace; no self-hosted face."
    },
    "text.reading": {
      "type": "dimension",
      "value": 17,
      "max": 20,
      "fluid": {
        "base": 16,
        "vw": 0.25
      },
      "web": "rem",
      "rationale": "Fluid reading size clamp(1.0625rem, 1rem + 0.25vw, 1.25rem). CMP uses the minimum."
    },
    "leading.reading": {
      "type": "number",
      "value": 1.85,
      "rationale": "Reading line height (unitless ratio)."
    },
    "measure": {
      "type": "dimension",
      "value": 672,
      "web": "rem",
      "rationale": "Reading measure 42rem."
    },
    "measure-wide": {
      "type": "dimension",
      "value": 1120,
      "web": "rem",
      "rationale": "New in UIS-02: Container Wide (70rem) for page-level layouts; reading text keeps measure."
    },
    "type.display": {
      "type": "typography",
      "value": {
        "family": "{font.reading}",
        "size": {
          "value": 32,
          "max": 48,
          "fluid": {
            "base": 24,
            "vw": 2
          }
