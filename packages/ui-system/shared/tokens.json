      },
      "dark": {
        "ref": "{black}",
        "alpha": 0.58
      },
      "rationale": "Overlay scrim behind dialogs and the account overlay."
    },
    "color.avatar-1": {
      "type": "color",
      "light": "{lavender.90}",
      "dark": "{lavender.28}",
      "rationale": "New in UIS-02: avatar tone 1 (lavender), chosen by avatar-identity-v1 from a caller-supplied stable key; independent of status roles so a status change never recolours people."
