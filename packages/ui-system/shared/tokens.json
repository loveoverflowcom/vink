    },
    "color.disabled-content": {
      "type": "color",
      "light": {
        "ref": "{neutral.12}",
        "alpha": 0.38
      },
      "dark": {
        "ref": "{neutral.94}",
        "alpha": 0.38
      },
      "rationale": "M3 disabled content (on-surface 38%); disabled controls are exempt from the contrast threshold but keep a visible reason."
    },
    "color.disabled-container": {
      "type": "color",
      "light": {
        "ref": "{neutral.12}",
        "alpha": 0.12
      },
      "dark": {
