{
  "format": 1,
  "version": "navigation-contract-v1",
  "note": "Golden vectors cho shared/navigation.md, dùng chung Leptos và CMP. windows: [đơn vị px|dp, bề rộng khả dụng, WindowClass]. layouts: [WindowClass, NavContext, RailPreference hoặc '-', NavLayout]. toggles: [NavLayout đang thấy, preference mới hoặc '-']. overlay: chuỗi bước [thao tác, kết quả] trên một OverlayLayer. focus: [lý do đóng, trigger còn thấy, nơi trả focus].",
  "breakpoints": {"cssPx": [760, 1100], "dp": [600, 840]},
  "windows": [
    ["px", 320, "compact"],
    ["px", 759, "compact"],
    ["px", 760, "medium"],
    ["px", 1099, "medium"],
    ["px", 1100, "expanded"],
    ["px", 1440, "expanded"],
    ["dp", 360, "compact"],
    ["dp", 599, "compact"],
    ["dp", 600, "medium"],
    ["dp", 839, "medium"],
    ["dp", 840, "expanded"],
    ["dp", 1280, "expanded"]
  ],
  "layouts": [
    ["compact", "-", "-", "bar"],
    ["compact", "-", "expanded", "bar"],
    ["compact", "-", "compact", "bar"],
    ["compact", "compact-rail", "-", "bar"],
    ["compact", "compact-rail", "expanded", "bar"],
    ["compact", "compact-rail", "compact", "bar"],
    ["compact", "hide-bar", "-", "bar:hidden"],
    ["compact", "hide-bar", "expanded", "bar:hidden"],
    ["compact", "hide-bar", "compact", "bar:hidden"],
    ["compact", "compact-rail+hide-bar", "-", "bar:hidden"],
    ["compact", "compact-rail+hide-bar", "expanded", "bar:hidden"],
    ["compact", "compact-rail+hide-bar", "compact", "bar:hidden"],
    ["medium", "-", "-", "rail:compact"],
    ["medium", "-", "expanded", "rail:expanded"],
    ["medium", "-", "compact", "rail:compact"],
    ["medium", "compact-rail", "-", "rail:compact"],
    ["medium", "compact-rail", "expanded", "rail:expanded"],
    ["medium", "compact-rail", "compact", "rail:compact"],
    ["medium", "hide-bar", "-", "rail:compact"],
    ["medium", "hide-bar", "expanded", "rail:expanded"],
    ["medium", "hide-bar", "compact", "rail:compact"],
    ["medium", "compact-rail+hide-bar", "-", "rail:compact"],
    ["medium", "compact-rail+hide-bar", "expanded", "rail:expanded"],
    ["medium", "compact-rail+hide-bar", "compact", "rail:compact"],
    ["expanded", "-", "-", "rail:expanded"],
    ["expanded", "-", "expanded", "rail:expanded"],
    ["expanded", "-", "compact", "rail:compact"],
    ["expanded", "compact-rail", "-", "rail:compact"],
    ["expanded", "compact-rail", "expanded", "rail:expanded"],
    ["expanded", "compact-rail", "compact", "rail:compact"],
    ["expanded", "hide-bar", "-", "rail:expanded"],
    ["expanded", "hide-bar", "expanded", "rail:expanded"],
    ["expanded", "hide-bar", "compact", "rail:compact"],
    ["expanded", "compact-rail+hide-bar", "-", "rail:compact"],
    ["expanded", "compact-rail+hide-bar", "expanded", "rail:expanded"],
    ["expanded", "compact-rail+hide-bar", "compact", "rail:compact"]
  ],
  "toggles": [
    ["rail:expanded", "compact"],
    ["rail:compact", "expanded"],
    ["bar", "-"],
    ["bar:hidden", "-"]
  ],
  "overlay": [
    {"name": "one-modal", "steps": [["open:profile", "ok"], ["open:profile", "ok"], ["open:leave", "busy:profile"], ["escape", "closed:profile:escape"], ["open:leave", "ok"], ["close:leave:dismiss", "closed:leave:dismiss"]]},
    {"name": "back-closes-overlay-first", "steps": [["open:profile", "ok"], ["back", "closed:profile:back"], ["back", "pass"], ["escape", "pass"]]},
    {"name": "stale-close", "steps": [["open:profile", "ok"], ["close:leave:dismiss", "stale"], ["close:profile:outside", "closed:profile:outside"], ["close:profile:outside", "stale"]]},
    {"name": "resize-and-navigate", "steps": [["open:profile", "ok"], ["close:profile:resize", "closed:profile:resize"], ["open:profile", "ok"], ["close:profile:navigate", "closed:profile:navigate"], ["back", "pass"]]}
  ],
  "focus": [
    ["dismiss", true, "trigger"],
    ["dismiss", false, "main"],
    ["escape", true, "trigger"],
    ["escape", false, "main"],
    ["back", true, "trigger"],
    ["back", false, "main"],
    ["outside", true, "trigger"],
    ["outside", false, "main"],
    ["resize", true, "trigger"],
    ["resize", false, "main"],
    ["navigate", true, "leave"],
    ["navigate", false, "leave"]
  ]
}
